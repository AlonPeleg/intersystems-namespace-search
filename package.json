{
  "name": "intersystems-namespace-search",
  "displayName": "InterSystems Namespace Search",
  "description": "Server-side namespace search (Studio Find in Files speed) with a background concurrent local scan as fallback.",
  "version": "1.7.9",
  "publisher": "alonpe",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onFileSystem:isfs",
    "onFileSystem:isfs-readonly",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "isfsNamespaceSearchContainer",
          "title": "ISFS Search",
          "icon": "images/isfs-search-icon.svg"
        },
        {
          "id": "isfsBookmarksContainer",
          "title": "ISFS Bookmarks",
          "icon": "images/isfs-bookmarks-icon.svg"
        },
        {
          "id": "isfsCodeLogContainer",
          "title": "Code Log",
          "icon": "images/isfs-codelog-icon.svg"
        }
      ]
    },
    "views": {
      "isfsNamespaceSearchContainer": [
        {
          "type": "webview",
          "id": "isfsNamespaceSearchView",
          "name": "Namespace Search",
          "icon": "images/isfs-search-icon.svg"
        }
      ],
      "isfsBookmarksContainer": [
        {
          "id": "isfsNamespaceSearch.bookmarksView",
          "name": "Bookmarks",
          "icon": "images/isfs-bookmarks-icon.svg"
        }
      ],
      "isfsCodeLogContainer": [
        {
          "id": "isfsNamespaceSearch.codeLogTree",
          "name": "Code Log",
          "icon": "images/isfs-codelog-icon.svg"
        },
        {
          "type": "webview",
          "id": "isfsNamespaceSearch.codeLogDetails",
          "name": "Details",
          "icon": "images/isfs-codelog-icon.svg"
        }
      ]
    },
    "keybindings": [
      {
        "command": "workbench.view.extension.isfsNamespaceSearchContainer",
        "key": "ctrl+alt+s"
      },
      {
        "command": "workbench.view.extension.isfsCodeLogContainer",
        "key": "ctrl+alt+l"
      },
      {
        "command": "isfsNamespaceSearch.goTo",
        "key": "ctrl+alt+g"
      },
      {
        "command": "isfsNamespaceSearch.openDocument.toggleView",
        "key": "ctrl+t",
        "when": "isfsNamespaceSearch.docPicker.open && inQuickOpen"
      },
      {
        "command": "isfsNamespaceSearch.openDocument.goUp",
        "key": "alt+left",
        "when": "isfsNamespaceSearch.docPicker.canGoUp && inQuickOpen"
      },
      {
        "command": "isfsNamespaceSearch.openDocument.backspaceUp",
        "key": "backspace",
        "when": "isfsNamespaceSearch.docPicker.canGoUp && inQuickOpen && isfsNamespaceSearch.docPicker.filterEmpty"
      },
      {
        "command": "isfsNamespaceSearch.openDocument.goToRoot",
        "key": "ctrl+h",
        "when": "isfsNamespaceSearch.docPicker.canGoUp && inQuickOpen"
      },
      {
        "command": "isfsNamespaceSearch.bookmarks.toggle",
        "key": "ctrl+f2",
        "when": "editorTextFocus && resourceScheme =~ /^isfs/"
      },
      {
        "command": "isfsNamespaceSearch.bookmarks.next",
        "key": "f2",
        "when": "editorTextFocus && resourceScheme =~ /^isfs/"
      },
      {
        "command": "isfsNamespaceSearch.bookmarks.clearFile",
        "key": "ctrl+alt+f2",
        "when": "editorTextFocus && resourceScheme =~ /^isfs/"
      },
      {
        "command": "isfsNamespaceSearch.openDocument.toggleCheck",
        "key": "ctrl+enter",
        "when": "isfsNamespaceSearch.docPicker.multi && inQuickOpen"
      }
    ],
    "configuration": {
      "title": "ISFS Namespace Search",
      "properties": {
        "isfsNamespaceSearch.useServerSideSearch": {
          "type": "boolean",
          "default": true,
          "description": "Search using the IRIS server's own Atelier API search (the same server-side search Studio's Find in Files uses) instead of downloading and scanning every matching file from the extension. Dramatically faster on any real namespace. Requires IRIS/Cache 2017.2+ and reuses the connection already established by 'Edit in Namespace' - if that can't be resolved, or the server doesn't support it, each search automatically falls back to the local scan below without you having to change this setting."
        },
        "isfsNamespaceSearch.serverSideSearchMinApiVersion": {
          "type": "number",
          "default": 4,
          "minimum": 1,
          "description": "Minimum Atelier apiVersion (as reported by the resolved server connection) required to trust server-side search. Confirmed by side-by-side testing: a server reporting apiVersion 3 can return a clean, error-free response that silently omits documents which do genuinely contain the searched text - Studio-equivalent server-side search on that version cannot be relied on. Any server below this minimum automatically and silently falls back to the local scan for correctness, while servers at or above it keep using the fast server-side search. Lower this only for a specific older server version you've personally confirmed returns complete results."
        },
        "isfsNamespaceSearch.serverSearchMaxResults": {
          "type": "number",
          "default": 5000,
          "minimum": 1,
          "description": "Maximum matches requested per server-side search. The Atelier API's own default is only 200, which can silently truncate a broad search - this raises that ceiling. Only applies when isfsNamespaceSearch.useServerSideSearch is on."
        },
        "isfsNamespaceSearch.allowSelfSignedCert": {
          "type": "boolean",
          "default": false,
          "description": "Accept self-signed/untrusted TLS certificates when this extension talks directly to the server for server-side search. Only enable this for a trusted development server you know uses a self-signed HTTPS certificate."
        },
        "isfsNamespaceSearch.dirConcurrency": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "description": "Local-scan fallback only. How many ISFS directory listings run in parallel while resolving a package path. Higher is faster for wide packages but puts more concurrent load on the IRIS server. Was fixed at 2; raise or lower to match your server."
        },
        "isfsNamespaceSearch.fileConcurrency": {
          "type": "number",
          "default": 8,
          "minimum": 1,
          "description": "Local-scan fallback only. How many files are read and scanned in parallel once the target file list is resolved. Higher is faster for searches over many files but puts more concurrent load on the IRIS server. Was fixed at 2; raise or lower to match your server."
        },
        "isfsNamespaceSearch.pauseBetweenReadsMs": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Local-scan fallback only. Artificial delay (ms) inserted before every ISFS read/list call, on top of the concurrency limits above. Defaults to 0; raise it only if your IRIS server needs a gentler pace."
        },
        "isfsNamespaceSearch.openDocument.defaultMode": {
          "type": "string",
          "enum": [
            "last",
            "tree",
            "flat"
          ],
          "default": "last",
          "enumDescriptions": [
            "Open in whichever view you used last.",
            "Always open as a package tree (like vscode-objectscript 3.8.2 and earlier).",
            "Always open as a flat list (like vscode-objectscript 3.8.3 and later)."
          ],
          "description": "Which view 'InterSystems: Open Document (Tree / Flat)' starts in. You can switch views inside the picker with its title-bar button, or by running the command again while the picker is open."
        },
        "isfsNamespaceSearch.pinIsfsEditors": {
          "type": "boolean",
          "default": true,
          "description": "Open server-side (isfs) documents as regular tabs instead of preview tabs, so a single click keeps them open. Only affects isfs documents; for all files use the built-in workbench.editor.enablePreview setting."
        }
      }
    },
    "commands": [
