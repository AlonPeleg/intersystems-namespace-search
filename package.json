          "command": "isfsNamespaceSearch.codeLog.addMembers",
          "when": "view == isfsNamespaceSearch.codeLogTree && viewItem =~ /^logFile/",
          "group": "1_add@1"
        },
        {
          "command": "isfsNamespaceSearch.codeLog.remove",
          "when": "view == isfsNamespaceSearch.codeLogTree && viewItem =~ /^log/",
          "group": "9_remove@1"
        },
        {
          "command": "isfsNamespaceSearch.codeLog.exportProject",
          "when": "view == isfsNamespaceSearch.codeLogTree && viewItem =~ /^logProject( |$)/",
