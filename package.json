          "when": "false"
        },
        {
          "command": "isfsNamespaceSearch.openDocument.goToRoot",
          "when": "false"
        },
        {
          "command": "isfsNamespaceSearch.openDocument.backspaceUp",
          "when": "false"
        },
        {
          "command": "isfsNamespaceSearch.bookmarks.clearNamespace",
          "when": "false"
        },
        {
          "command": "isfsNamespaceSearch.bookmarks.delete",
          "when": "false"
        },
        {
