{
  "name": "intersystems-namespace-search",
  "displayName": "InterSystems Namespace Search",
  "description": "Background concurrent ISFS full-text search with dedicated Activity Bar view.",
  "version": "1.0.0",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onFileSystem:isfs",
    "onFileSystem:isfs-readonly"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "isfsNamespaceSearchContainer",
          "title": "ISFS Namespace Search",
          "icon": "$(search)"
        }
      ]
    },
    "views": {
      "isfsNamespaceSearchContainer": [
        {
          "id": "isfsNamespaceSearchView",
          "name": "ISFS Results"
        }
      ]
    },
    "commands": [
      {
        "command": "intersystems-namespace-search.searchInNamespace",
        "title": "New ISFS Search",
        "icon": "$(search-search)"
      },
      {
        "command": "intersystems-namespace-search.clearResults",
        "title": "Clear Search Results",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "intersystems-namespace-search.searchInNamespace",
          "when": "view == isfsNamespaceSearchView",
          "group": "navigation"
        },
        {
          "command": "intersystems-namespace-search.clearResults",
          "when": "view == isfsNamespaceSearchView",
          "group": "navigation"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/AlonPeleg/intersystems-namespace-search"
  }
}