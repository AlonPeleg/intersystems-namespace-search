{
  "name": "intersystems-namespace-search",
  "displayName": "InterSystems Namespace Search",
  "description": "Background concurrent ISFS search with optimized direct path target resolution.",
  "version": "1.0.0",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onFileSystem:isfs",
    "onFileSystem:isfs-readonly"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "isfsNamespaceSearchContainer",
          "title": "ISFS Search",
          "icon": "$(search)"
        }
      ]
    },
    "views": {
      "isfsNamespaceSearchContainer": [
        {
          "type": "webview",
          "id": "isfsNamespaceSearchView",
          "name": "Namespace Search"
        }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.80.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {},
  "repository": {
    "type": "git",
    "url": "https://github.com/AlonPeleg/intersystems-namespace-search"
  }
}