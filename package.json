      "view/item/context": [
        {
          "command": "isfsNamespaceSearch.bookmarks.delete",
          "when": "view == isfsNamespaceSearch.bookmarksView && viewItem == bookmarkItem",
          "group": "inline"
        },
        {
          "command": "isfsNamespaceSearch.bookmarks.clearFile",
          "when": "view == isfsNamespaceSearch.bookmarksView && viewItem == fileItem",
          "group": "inline"
        },
        {
          "command": "isfsNamespaceSearch.bookmarks.clearNamespace",
          "when": "view == isfsNamespaceSearch.bookmarksView && viewItem == namespaceItem",
          "group": "inline"
        },
        {
          "command": "isfsNamespaceSearch.codeLog.newSubfolder",
          "when": "view == isfsNamespaceSearch.codeLogTree && viewItem =~ /^log(Project|Folder)( |$)/",
          "group": "inline@1"
        },
        {
          "command": "isfsNamespaceSearch.codeLog.addFiles",
          "when": "view == isfsNamespaceSearch.codeLogTree && viewItem =~ /^log(Project|Folder)( |$)/",
          "group": "inline@2"
        },
        {
          "command": "isfsNamespaceSearch.codeLog.addFiles",
          "when": "view == isfsNamespaceSearch.codeLogTree && viewItem =~ /^log(Project|Folder)( |$)/",
          "group": "1_add@1"
        },
        {
          "command": "isfsNamespaceSearch.codeLog.newSubfolder",
          "when": "view == isfsNamespaceSearch.codeLogTree && viewItem =~ /^log(Project|Folder)( |$)/",
          "group": "1_add@2"
        },
        {
          "command": "isfsNamespaceSearch.codeLog.renameFolder",
          "when": "view == isfsNamespaceSearch.codeLogTree && viewItem =~ /^log(Project|Folder)( |$)/",
          "group": "2_edit@1"
        },
        {
          "command": "isfsNamespaceSearch.codeLog.move",
          "when": "view == isfsNamespaceSearch.codeLogTree && viewItem =~ /^log(Folder|File)/",
          "group": "2_edit@2"
        },
        {
          "command": "isfsNamespaceSearch.codeLog.copy",
          "when": "view == isfsNamespaceSearch.codeLogTree && viewItem =~ /^log(Folder|File)/",
          "group": "2_edit@3"
        },
        {
          "command": "isfsNamespaceSearch.codeLog.addMembers",
